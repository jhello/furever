# 复制为 .env 后按需修改。start-server.sh 会自动加载。
# 不要把真实密钥提交到版本库（.env 已在 .gitignore 中）。

# 监听
FUREVER_HOST=0.0.0.0
FUREVER_PORT=3000

# 数据目录与数据库（留空则用 <项目>/data）
# FUREVER_DATA_DIR=/var/lib/furever
# FUREVER_DB_PATH=/var/lib/furever/furever.db

# 管理员令牌（留空则自动生成并保存到 data/admin-token）
# FUREVER_ADMIN_TOKEN=change-me

# 登录会话闲置有效天数（每次使用自动续期，手动登出立即失效）
FUREVER_SESSION_DAYS=30

# 忘记密码重置令牌有效期（分钟）
FUREVER_RESET_MINUTES=1440

# 覆盖 HTML5 页面与看板目录
# FUREVER_WEB_DIR=/opt/furever/web
# FUREVER_DASHBOARD_DIR=/opt/furever/server/public/dashboard
